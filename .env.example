# Optional macOS signing for release/macos/build-package.sh. Leave unset for an
# ad-hoc local build. A Developer ID build also needs the notary API key.
# MUXFLOW_MACOS_SIGNING_IDENTITY='Developer ID Application: Your Name (TEAMID)'
# MUXFLOW_APPLE_TEAM_ID='TEAMID'
# MUXFLOW_NOTARY_KEY_PATH="$HOME/.private_keys/AuthKey_XXXXXXXXXX.p8"
# MUXFLOW_NOTARY_KEY_ID='XXXXXXXXXX'
# MUXFLOW_NOTARY_ISSUER='00000000-0000-0000-0000-000000000000'
