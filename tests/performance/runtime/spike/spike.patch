+// ---------------------------------------------------------------------------
+// SPIKE (ADE_SPIKE_INBAND_INPUT=1): write `send-keys -H` in-band through the
+// already-open tmux -C control client instead of forking three tmux processes
+// per input request. Throwaway experiment code; not production shaped.
+// ---------------------------------------------------------------------------
+
+/// Largest payload the in-band path accepts. Bigger requests keep the atomic
+/// load-buffer/paste-buffer commit path.
+pub(super) const SPIKE_INBAND_MAX_BYTES: usize = 1024;
+
+pub(super) fn spike_inband_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("ADE_SPIKE_INBAND_INPUT").as_deref() == Ok("1"))
+}
+
+pub(super) fn spike_trace_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("ADE_SPIKE_TRACE").as_deref() == Ok("1"))
+}
+
+fn send_input_inband(
+    stdin: &Arc<Mutex<ChildStdin>>,
+    pane_id: &str,
+    data: &[u8],
+) -> Result<(), String> {
+    validate_tmux_id(pane_id, '%').map_err(|error| error.to_string())?;
+    // `send-keys -H` takes one hex literal per byte, so the whole request is a
+    // single tmux command executed atomically in receive order.
+    let mut line = String::with_capacity(16 + data.len() * 3);
+    line.push_str("send-keys -H -t ");
+    line.push_str(pane_id);
+    for byte in data {
+        line.push(' ');
+        line.push_str(&format!("{byte:02x}"));
+    }
+    line.push('\n');
+    let mut writer = stdin
+        .lock()
+        .map_err(|_| "tmux control stdin is poisoned".to_owned())?;
+    writer
+        .write_all(line.as_bytes())
+        .map_err(|error| format!("in-band tmux input write failed: {error}"))?;
+    writer
+        .flush()
+        .map_err(|error| format!("in-band tmux input flush failed: {error}"))?;
+    Ok(())
+}
