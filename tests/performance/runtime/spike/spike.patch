+fn stats(mut samples: Vec<f64>) -> serde_json::Value {
+    samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let sum: f64 = samples.iter().sum();
+    json!({
+        "n": samples.len(),
+        "meanMs": (sum / samples.len() as f64 * 1000.0).round() / 1000.0,
+        "p50Ms": (percentile(&samples, 0.5) * 1000.0).round() / 1000.0,
+        "p95Ms": (percentile(&samples, 0.95) * 1000.0).round() / 1000.0,
+        "minMs": (samples.first().copied().unwrap_or_default() * 1000.0).round() / 1000.0,
+        "maxMs": (samples.last().copied().unwrap_or_default() * 1000.0).round() / 1000.0,
+    })
+}
