+// ---------------------------------------------------------------------------
+// SPIKE (ADE_SPIKE_BATCH_DISCOVERY=1): `discover_consistent` costs five tmux
+// forks (identity, list-sessions, list-windows, list-panes, identity again).
+// On macOS one tmux client fork costs ~6 ms, so discovery alone is ~30 ms and
+// every tmux action pays it twice or three times. tmux accepts several commands
+// in one client invocation, so the same data can be fetched with a single fork.
+// The before/after identity race check becomes unnecessary: one client
+// invocation is bound to one server for its whole lifetime.
+// ---------------------------------------------------------------------------
+const SPIKE_SESSION_FORMAT: &str = "#{session_id}__ADE_TMUX_FIELD_9C71__#{session_name}__ADE_TMUX_FIELD_9C71__#{session_windows}__ADE_TMUX_FIELD_9C71__#{session_attached}";
+const SPIKE_WINDOW_FORMAT: &str = "#{session_id}__ADE_TMUX_FIELD_9C71__#{window_id}__ADE_TMUX_FIELD_9C71__#{window_index}__ADE_TMUX_FIELD_9C71__#{window_name}__ADE_TMUX_FIELD_9C71__#{window_active}__ADE_TMUX_FIELD_9C71__#{window_layout}__ADE_TMUX_FIELD_9C71__#{window_zoomed_flag}";
+const SPIKE_PANE_FORMAT: &str = "#{session_id}__ADE_TMUX_FIELD_9C71__#{window_id}__ADE_TMUX_FIELD_9C71__#{pane_id}__ADE_TMUX_FIELD_9C71__#{pane_index}__ADE_TMUX_FIELD_9C71__#{pane_active}__ADE_TMUX_FIELD_9C71__#{pane_width}__ADE_TMUX_FIELD_9C71__#{pane_height}__ADE_TMUX_FIELD_9C71__#{pane_left}__ADE_TMUX_FIELD_9C71__#{pane_top}__ADE_TMUX_FIELD_9C71__#{pane_current_path}__ADE_TMUX_FIELD_9C71__#{pane_current_command}__ADE_TMUX_FIELD_9C71__#{pane_pid}__ADE_TMUX_FIELD_9C71__#{pane_start_command}";
+
+pub(super) fn spike_batch_discovery_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("ADE_SPIKE_BATCH_DISCOVERY").as_deref() == Ok("1"))
+}
+
+fn discover_consistent_batched() -> anyhow::Result<(TmuxSnapshot, String)> {
+    let mut command = tmux_command();
+    command.args([
+        "display-message",
+        "-p",
+        "__ADE_ID__#{socket_path}",
+        ";",
+        "list-sessions",
+        "-F",
+        &format!("__ADE_S__{SPIKE_SESSION_FORMAT}"),
+        ";",
+        "list-windows",
+        "-a",
+        "-F",
+        &format!("__ADE_W__{SPIKE_WINDOW_FORMAT}"),
+        ";",
+        "list-panes",
+        "-a",
+        "-F",
+        &format!("__ADE_P__{SPIKE_PANE_FORMAT}"),
+    ]);
+    let output = command.output().context("batched tmux discovery")?;
+    if !output.status.success() {
+        bail!("tmux server is unavailable");
+    }
+    let text = String::from_utf8_lossy(&output.stdout).into_owned();
+    let mut identity_raw = None;
+    let (mut sessions, mut windows, mut panes) = (Vec::new(), Vec::new(), Vec::new());
+    for line in text.lines() {
+        if let Some(rest) = line.strip_prefix("__ADE_ID__") {
+            identity_raw = Some(rest.to_owned());
+        } else if let Some(rest) = line.strip_prefix("__ADE_S__") {
+            sessions.push(rest.to_owned());
+        } else if let Some(rest) = line.strip_prefix("__ADE_W__") {
+            windows.push(rest.to_owned());
+        } else if let Some(rest) = line.strip_prefix("__ADE_P__") {
+            panes.push(rest.to_owned());
+        }
+    }
+    let identity_raw = identity_raw.context("batched discovery lost the server identity")?;
+    let identity = socket_server_identity(&tmux_socket_path(identity_raw.trim_end()))
+        .unwrap_or_else(|_| "tmux:none".into());
+    if identity == "tmux:none" {
+        bail!("tmux server is unavailable");
+    }
+    // Replay the already-fetched lines through the shared parser so record
+    // parsing stays identical to the unbatched path.
+    let mut value = tmux_control::discover_with(|args| {
+        let bucket = match args.first().map(String::as_str) {
+            Some("list-sessions") => &sessions,
+            Some("list-windows") => &windows,
+            _ => &panes,
+        };
+        let mut stdout = bucket.join("\n").into_bytes();
+        if !stdout.is_empty() {
+            stdout.push(b'\n');
+        }
+        Ok(std::process::Output {
+            status: batched_success_status(),
+            stdout,
+            stderr: Vec::new(),
+        })
+    })?;
+    overlay_session_order(&mut value, &identity)?;
+    Ok((value, identity))
+}
+
+fn batched_success_status() -> std::process::ExitStatus {
+    use std::os::unix::process::ExitStatusExt as _;
+    std::process::ExitStatus::from_raw(0)
+}
