+    let mut close_session: Vec<f64> = Vec::new();
+    for index in 0..6 {
+        let snapshot = client.snapshot()?;
+        let mut create = action(v1::TmuxActionKind::CreateSession);
+        create.name = format!("spike-session-{index}");
+        let started = Instant::now();
+        let response = client.action_with_snapshot(&snapshot, create)?;
+        let elapsed = started.elapsed().as_secs_f64() * 1000.0;
+        ensure!(
+            response.ok,
+            "spike create session failed: {} ({})",
+            response.error_code,
+            response.display_message
+        );
+        create_session.push(elapsed);
+        let session_id = response
+            .tmux_action_result
+            .context("create session omitted result")?
+            .session_id;
+        let snapshot = client.snapshot()?;
+        let mut close = action(v1::TmuxActionKind::CloseSession);
+        close.session_id = session_id;
+        close.confirmed = true;
+        let started = Instant::now();
+        let response = client.action_with_snapshot(&snapshot, close)?;
+        ensure!(response.ok, "spike close session failed");
+        close_session.push(started.elapsed().as_secs_f64() * 1000.0);
+    }
+
+    // Correctness probe: the keystrokes above must land in order, exactly once.
+    let marker = format!("SPIKE_ORDER_{}", std::process::id());
+    client.request_seed(&original_pane.id)?;
+    client.pump_until(|observations| observations.seeded_panes.contains(&original_pane.id))?;
