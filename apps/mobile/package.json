{
  "name": "@muxflow/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "apk": "bash scripts/build-apk.sh",
    "apk:release": "bash scripts/build-apk.sh release",
    "check": "tsc --noEmit",
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android",
    "protocol:check": "pnpm run protocol:gen && git diff --exit-code -- src/protocol/gen && test -z \"$(git ls-files --others --exclude-standard -- src/protocol/gen)\"",
    "protocol:gen": "buf generate",
    "sideload": "bash scripts/install-apk.sh",
    "sideload:release": "bash scripts/install-apk.sh release",
    "test": "vitest run",
    "webview:build": "node scripts/build-webview.mjs",
    "webview:check": "pnpm run webview:build && git diff --exit-code -- src/webview src/features/terminal/terminalHtml.ts assets/webview && test -z \"$(git ls-files --others --exclude-standard -- src/webview src/features/terminal/terminalHtml.ts assets/webview)\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "expo": "57.0.16",
    "expo-audio": "57.0.4",
    "expo-build-properties": "57.0.14",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.14",
    "expo-dev-client": "57.0.15",
    "expo-file-system": "57.0.6",
    "expo-font": "57.0.1",
    "expo-linking": "57.0.7",
    "expo-notifications": "57.0.14",
    "expo-router": "57.0.16",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "babel-preset-expo": "57.0.8",
    "dompurify": "3.4.13",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "marked": "18.0.9",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
