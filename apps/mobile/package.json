{
  "name": "@muxflow/mobile",
  "version": "0.1.40",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "apk": "bash scripts/build-apk.sh",
    "apk:release": "bash scripts/build-apk.sh release",
    "check": "tsc --noEmit",
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android",
    "protocol:check": "pnpm run protocol:gen && git diff --exit-code -- src/protocol/gen src/protocol/testing/rust_vectors.json && test -z \"$(git ls-files --others --exclude-standard -- src/protocol/gen src/protocol/testing/rust_vectors.json)\"",
    "protocol:gen": "buf generate && MUXFLOW_UPDATE_CONTRACT=1 cargo test -p tmux-agent-protocol --test mobile_contract",
    "sideload": "bash scripts/install-apk.sh",
    "sideload:release": "bash scripts/install-apk.sh release",
    "test": "vitest run",
    "webview:build": "node scripts/build-webview.mjs",
    "webview:check": "pnpm run webview:build && git diff --exit-code -- src/webview src/features/terminal/terminalHtml.ts assets/webview && test -z \"$(git ls-files --others --exclude-standard -- src/webview src/features/terminal/terminalHtml.ts assets/webview)\"",
    "ios": "expo run:ios",
    "ios:simulator": "bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@muxflow/terminal-interactions": "workspace:*",
    "@bufbuild/protobuf": "2.17.0",
    "@noble/hashes": "2.4.0",
    "expo": "58.0.26",
    "expo-audio": "58.0.12",
    "expo-build-properties": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.14",
    "expo-font": "58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "58.0.10",
    "expo-intent-launcher": "58.0.3",
    "expo-keep-awake": "58.0.4",
    "expo-linking": "58.0.17",
    "expo-notifications": "58.1.9",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "marked": "18.2.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "5.1.0",
    "@muxflow/client-core": "workspace:*",
    "@muxflow/markdown": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "babel-preset-expo": "58.0.26",
    "dompurify": "3.4.18",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "react-test-renderer": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
