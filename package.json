{
  "name": "muxflow",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @muxflow/desktop build",
    "check": "pnpm --filter @muxflow/desktop check",
    "check:privacy": "bash tests/release/check-repo-privacy.sh",
    "clean:rust": "bash release/clean-rust-cache.sh",
    "dev": "pnpm --filter @muxflow/desktop dev",
    "mobile:apk": "pnpm --filter @muxflow/mobile apk",
    "mobile:apk:release": "pnpm --filter @muxflow/mobile apk:release",
    "mobile:check": "pnpm --filter @muxflow/mobile check",
    "mobile:dev": "pnpm --filter @muxflow/mobile dev",
    "mobile:sideload": "pnpm --filter @muxflow/mobile sideload",
    "mobile:sideload:release": "pnpm --filter @muxflow/mobile sideload:release",
    "mobile:test": "pnpm --filter @muxflow/mobile test",
    "test:transport:local": "bash tests/integration/transport/run-local.sh",
    "test:transport:ssh": "bash tests/integration/transport/run-docker-ssh.sh",
    "test:transport:ssh:keep": "ADE_PHASE0_KEEP_CONTAINER=1 bash tests/integration/transport/run-docker-ssh.sh",
    "test:lifecycle": "bash tests/integration/lifecycle/run-linux.sh",
    "test:lifecycle:desktop": "bash tests/integration/lifecycle/run-thin-desktop.sh",
    "test:protocol": "bash tests/integration/protocol/run-backend.sh",
    "test:shell": "bash tests/integration/shell/run-shell.sh",
    "test:files": "bash tests/integration/filesystem/run-backend.sh",
    "test:git": "bash tests/integration/git/run-backend.sh",
    "test:git:ssh": "bash tests/integration/git/run-docker-ssh.sh",
    "test:agents": "bash tests/integration/agents/run-backend.sh",
    "test:agents:ssh": "bash tests/integration/agents/run-docker-ssh.sh",
    "test:transfers": "bash tests/integration/transfers/run-backend.sh",
    "test:transfers:local": "bash tests/integration/transfers/run-local-transfer.sh",
    "test:transfers:parent-swap": "bash tests/integration/transfers/run-parent-swap.sh",
    "test:transfers:smoke": "bash tests/integration/transfers/run-smoke.sh",
    "test:transfers:ssh": "bash tests/integration/transfers/run-docker-ssh.sh",
    "test:package": "bash tests/release/run-package.sh",
    "test:release": "bash tests/release/run-regressions.sh",
    "test:release:matrix": "bash tests/release/run-matrix.sh",
    "test:release:heavy": "bash tests/release/run-release-matrix.sh",
    "test:acceptance": "bash tests/acceptance/linux/run-acceptance.sh",
    "test:performance": "bash tests/performance/runtime/run-perf.sh",
    "test:performance:pause": "bash tests/performance/runtime/run-pause-probe.sh",
    "test:performance:pause:reject": "REJECT_RESUME=1 bash tests/performance/runtime/run-pause-probe.sh 12",
    "test:performance:stall": "bash tests/performance/runtime/run-stall.sh",
    "release:linux": "bash release/linux/build-package.sh",
    "release:macos": "bash release/macos/build-package.sh",
    "tauri": "pnpm --filter @muxflow/desktop tauri",
    "test": "pnpm --filter @muxflow/desktop test"
  }
}
